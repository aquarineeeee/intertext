APP_NAME=Intertext API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://intertext:change-me@localhost:5432/intertext
SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=intertext_session
SESSION_TTL_SECONDS=2592000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=http://localhost:3000
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=storage
MAX_UPLOAD_SIZE_BYTES=20971520
# S3-compatible storage is reserved for production configuration.
# S3_ENDPOINT_URL=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=
