APP_NAME=Intertext API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://intertext:change-me@localhost:5432/intertext
SECRET_KEY=replace-with-a-long-random-secret
# Optional separate key for encrypting AI Provider secrets; defaults to SECRET_KEY.
ENCRYPTION_KEY=
SESSION_COOKIE_NAME=intertext_session
SESSION_TTL_SECONDS=2592000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=http://localhost:3000
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=storage
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_IMPORT_SIZE_BYTES=209715200
CSRF_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
SECURITY_HEADERS_ENABLED=true
LOG_LEVEL=INFO
# S3-compatible storage is reserved for production configuration.
# S3_ENDPOINT_URL=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=
MCP_REQUEST_TIMEOUT_SECONDS=10
MCP_MAX_RESPONSE_BYTES=1048576
MCP_MAX_CONCURRENT_CALLS=4
MCP_MAX_REDIRECTS=3
# Optional global safety allowlist. A server's own allowlist is also required.
# MCP_ALLOWED_TOOLS=["memory_search"]
